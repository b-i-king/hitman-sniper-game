# Copy to .env and fill in. Everything is optional: with no keys the game runs with the
# browser's own speech recognition and voices.

# --- Fish Audio (sniper + target voices, push-to-talk speech-to-text) ---------------
# https://fish.audio/app/api-keys
FISH_API_KEY=
# s2.1-pro (recommended) | s2.1-pro-free (free tier, no latency guarantee) | s2-pro | s1
FISH_TTS_MODEL=s2.1-pro
# transcribe-1 (fast, short clips) | transcribe-1-pro
FISH_STT_MODEL=transcribe-1
# Voice model ids from https://fish.audio (leave empty for Fish's default voice)
FISH_SNIPER_VOICE_ID=
FISH_TARGET_VOICE_ID=

# --- Optional LLM: interprets free-form sentences the built-in parser doesn't get ----
# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, Ollama, Anthropic's OpenAI-compatible API...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

PORT=3000
